{
  "name": "doc-extract",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "postCreateCommand": "pip install --user -r requirements.txt && pip install --user reportlab",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "doc-extract MCP",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python" }
    }
  },
  "remoteEnv": {
    "MCP_TRANSPORT": "http",
    "PORT": "8000"
  }
}
